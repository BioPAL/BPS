%
% Tables, captions and figures of the Science Guide PDF exports.
% Loaded by atbdlayout.sty (colours and document metadata are defined there).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{atbdfloats}[2026/11/23 BPS Science Guide PDF layout]

% Table font: ATBD 9/10.5 pt, PFD 10/11.5 pt (set by conf.py).
\providecommand\atbdtablefont{\linespread{1}\fontsize{9}{10.5}\selectfont}
% A row taller than a page is set as several rows (atbd_latex_content.py):
% \atbdrowcontinues in a row drops the rule under it, so that the next row
% reads as its continuation and the page can break between them (no
% negative space: the next cell background would hide the last line).
% \atbdrowcontinuation (longtable.tex.jinja) wraps the \sphinxhline of the
% table style.
\newif\ifatbd@rowcont
\newcommand\atbdrowcontinues{\global\atbd@rowconttrue}
\newcommand\atbdrowcontinuation{%
  \let\atbd@hline\sphinxhline
  \def\sphinxhline{\ifatbd@rowcont
    \noalign{\global\atbd@rowcontfalse}%
    \else\atbd@hline\fi}}

% ---------------------------------------------------------------------------
% Tables (see _templates/latex/longtable.tex.jinja): ragged-right cells, the
% table font of the originals, as wide as the headings (left indent).
% ---------------------------------------------------------------------------
\newcolumntype{\X}[2]{>{\raggedright\arraybackslash}p{\dimexpr
      (\linewidth-\spx@arrayrulewidth)*#1/#2-\tw@\tabcolsep-\spx@arrayrulewidth\relax}}
\providecommand\atbdwideextra{0pt}
\newcommand\atbdwidetable{%
  \advance\linewidth\atbdheadindent
  \advance\linewidth\atbdwideextra
  \advance\@totalleftmargin-\atbdheadindent}
% Grid of the originals: rule colour and width, header fill and cell padding
% (atbd_pdf_layout.py defines atbdtablerule, atbdtablehead, \atbdtableruledth).
\providecolor{atbdtablerule}{HTML}{A6A6A6}
\providecolor{atbdtablehead}{HTML}{F2F2F2}
\providecommand\atbdtableruledth{0.48bp}
\newcommand\atbdtablegrid{%
  \arrayrulecolor{atbdtablerule}\setlength\arrayrulewidth{\atbdtableruledth}%
  \setlength\tabcolsep{5.4bp}%
  \colorlet{sphinxTableRowColorHeader}{atbdtablehead}}
% Bold header row, as in the originals.
\renewcommand\sphinxstyletheadfamily{\sffamily\bfseries}
% Input and output tables of the ATBDs: header and cells centred.
\newcommand\atbdcenteredcells{%
  \renewcommand\sphinxstyletheadfamily{\sffamily\bfseries\centering\arraybackslash}%
  \newcolumntype{\X}[2]{>{\centering\arraybackslash}p{\dimexpr
      (\linewidth-\spx@arrayrulewidth)*##1/##2-\tw@\tabcolsep-\spx@arrayrulewidth\relax}}}
\newlength\atbdcaptionskip
\setlength\atbdcaptionskip{4pt}
% Underscores of long identifiers may break the line inside table cells.
% Identifiers (inline literals) are set in the font of the table text, as
% in the originals (Arial), not in Courier.
\protected\def\atbd@plaincode#1{#1}
\AtBeginEnvironment{longtable}{%
  \hyphenpenalty=10000 \exhyphenpenalty=10000 % no hyphenation in cells (Word)
  \let\sphinxcode\atbd@plaincode%
  \let\atbd@underscore\_%
  \def\_{\atbd@underscore\allowbreak}}

% A caption below the table (\endlastfoot) is taller than the foot reserved
% at each page break, and its depth (\parbox[t]) is not counted: when the
% last rows fit but not the caption, longtable sets the caption alone at the
% top of the next page. Carry
% the last rows over with it instead (longtable.sty \LT@output, end branch).
\newbox\atbd@ltrows
\def\LT@output{%
  \ifnum\outputpenalty <-\@Mi
    \ifnum\outputpenalty > -\LT@end@pen
      \LT@err{floats and marginpars not allowed in a longtable}\@ehc
    \else
      \setbox\z@\vbox{\unvbox\@cclv}%
      \dimen@\dp\LT@lastfoot \advance\dimen@\ht\LT@lastfoot
      \ifdim \dimen@>\ht\LT@foot
        \dimen@\pagegoal
        \advance\dimen@\ht\LT@foot
        \advance\dimen@-\ht\LT@lastfoot
        \advance\dimen@-\dp\LT@lastfoot
        \ifdim\dimen@<\ht\z@
          \begingroup
            \vbadness\@M \vfuzz\maxdimen \splittopskip\z@ \splitmaxdepth\maxdimen
            \global\setbox\atbd@ltrows\vsplit\z@ to \dimen@
          \endgroup
          \setbox\@cclv\vbox{\unvbox\atbd@ltrows\copy\LT@foot\vss}%
          \@makecol
          \@outputpage
          \global\vsize\@colroom
          \setbox\z@\vbox{\box\LT@head\nobreak\unvbox\z@}%
        \fi
      \fi
        \unvbox\z@\nobreak\box\ifvoid\LT@lastfoot\LT@foot\else\LT@lastfoot\fi
    \fi
  \else
    \setbox\@cclv\vbox{\unvbox\@cclv\copy\LT@foot\vss}%
    \@makecol
    \@outputpage
      \global\vsize\@colroom
    \copy\LT@head\nobreak
  \fi}

% ---------------------------------------------------------------------------
% Captions: bold "Fig.N" / "Tab.N" label then the text, as in the originals.
% ---------------------------------------------------------------------------
\renewcommand\fnum@figure{\textbf{Fig.\thefigure}}
\renewcommand\fnum@table{\textbf{Tab.\thetable}}
\long\def\@makecaption#1#2{%
  \vskip\abovecaptionskip
  \sbox\@tempboxa{#1\enspace #2}%
  \ifdim\wd\@tempboxa>\hsize #1\enspace #2\par
  \else\global\@minipagefalse\hb@xt@\hsize{\hfil\box\@tempboxa\hfil}\fi
  \vskip\belowcaptionskip}
\def\LT@makecaption#1#2#3{%
  \LT@mcol\LT@cols c{\sphinxnorowcolor\hbox to\z@{\hss\parbox[t]\LTcapwidth{%
    \sbox\@tempboxa{#1{#2\enspace}#3}%
    \ifdim\wd\@tempboxa>\hsize #1{#2\enspace}#3%
    \else\hbox to\hsize{\hfil\box\@tempboxa\hfil}\fi
    \endgraf\vskip\baselineskip}\hss}}}

% ---------------------------------------------------------------------------
% Figures: floating ([!htp]), at the size of the original rendering
% (raster images are shown at 65 % of their 72 dpi size), never wider than
% 85 % of the text width; white margins of the rasters are trimmed with the
% values computed at build time (atbdtrim.tex, see atbd_latex_content.py).
% ---------------------------------------------------------------------------
\RequirePackage{pdflscape}
\setcounter{topnumber}{3}
\setcounter{bottomnumber}{0}
\setcounter{totalnumber}{4}
\renewcommand\topfraction{.9}
\renewcommand\bottomfraction{.8}
\renewcommand\textfraction{.1}
\renewcommand\floatpagefraction{.8}
% \atbdfigurehere: the next figure is set in place ([H]); used before a
% longtable, which ignores pending floats when it breaks the page.
\newif\ifatbd@figurehere
\newcommand\atbdfigurehere{\atbd@figureheretrue}
\let\atbd@figure\figure
\renewcommand\figure[1][\fps@figure]{%
  \ifatbd@figurehere\atbd@figureherefalse\atbd@figure[H]%
  \else\atbd@figure[#1]\fi}
\newcommand\atbdfigscale{0.65}
\newcommand\atbdfigmaxwidth{0.85\linewidth}
\newcommand\atbdsettrim[2]{\@namedef{atbd@trim@\detokenize{#1}}{#2}}
\InputIfFileExists{atbdtrim.tex}{}{}
\let\atbd@sphinxincludegraphics\sphinxincludegraphics
\renewcommand\sphinxincludegraphics[2][]{%
  \begingroup
  \@ifundefined{atbd@trim@\detokenize{#2}}%
    {\def\atbd@trim{}}%
    {\edef\atbd@trim{trim=\csname atbd@trim@\detokenize{#2}\endcsname,clip,}}%
  \ifx\relax#1\relax
    \setbox\z@\hbox{\expandafter\includegraphics\expandafter[\atbd@trim draft]{#2}}%
    \dimen@=\atbdfigscale\wd\z@
    \edef\atbd@opts{\atbd@trim width=\the\dimen@}%
  \else
    \edef\atbd@opts{\atbd@trim #1}%
  \fi
  \linewidth=\atbdfigmaxwidth
  \expandafter\atbd@sphinxincludegraphics\expandafter[\atbd@opts]{#2}%
  \endgroup}

\endinput
