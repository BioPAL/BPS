%
% Page layout of the Science Guide PDF exports (ATBD / PFD), modelled on the
% original ESA / Aresys documents: A4, Arial-like font, blue headings,
% logo + reference box in the header, "page X/Y" footer, cover page.
%
% The document metadata is defined by conf.py before this package is loaded:
%   \atbdtitle \atbdcode \atbdissue \atbddate \atbdbpsversion
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{atbdlayout}[2026/11/05 BPS Science Guide PDF layout]

\RequirePackage{fontspec}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{array}
\RequirePackage{colortbl}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage{titlesec}
\RequirePackage{tocloft}
\RequirePackage{etoolbox}
\RequirePackage{needspace}

\providecommand\atbdtitle{}
\providecommand\atbdcode{}
\providecommand\atbdissue{}
\providecommand\atbddate{}
\providecommand\atbdbpsversion{}
\providecommand\atbdcovertitle{\atbdtitle}
% Table font: ATBD 9/10.5 pt, PFD 10/11.5 pt (set by conf.py).
\providecommand\atbdtablefont{\linespread{1}\fontsize{9}{10.5}\selectfont}
% A row taller than a page is set as several rows (atbd_latex_content.py):
% \atbdrowcontinues in a row drops the rule under it, so that the next row
% reads as its continuation and the page can break between them (no
% negative space: the next cell background would hide the last line).
% \atbdrowcontinuation (longtable.tex.jinja) wraps the \sphinxhline of the
% table style.
\newif\ifatbd@rowcont
\newcommand\atbdrowcontinues{\global\atbd@rowconttrue}
\newcommand\atbdrowcontinuation{%
  \let\atbd@hline\sphinxhline
  \def\sphinxhline{\ifatbd@rowcont
    \noalign{\global\atbd@rowcontfalse}%
    \else\atbd@hline\fi}}
% "Issue x – BPS vY" (no BPS part when the version is unknown).
\newcommand\atbdissueline{Issue \atbdissue
  \ifdefempty{\atbdbpsversion}{}{\ – BPS v\atbdbpsversion}}

% ---------------------------------------------------------------------------
% Colours (sampled from the original PDFs)
% ---------------------------------------------------------------------------
\definecolor{atbdblue}{HTML}{2F5496}     % headings
\definecolor{atbdnavy}{HTML}{1F3864}     % page number
\definecolor{atbdgrey}{HTML}{808080}     % header text
\definecolor{atbdtitlegrey}{HTML}{595959}% cover title
\definecolor{atbdrule}{HTML}{FFC000}     % header / footer rules
\definecolor{atbdbox}{HTML}{D0CECE}      % header box borders
\definecolor{atbdcover}{HTML}{7786A0}    % cover reference band

% ---------------------------------------------------------------------------
% Fonts: Arial in the original documents. Liberation Sans has the same metrics
% (same line breaks and pagination); the CI and the LaTeX image install it
% (fonts-liberation). Fonts are looked up by file name, which does not start
% a METAFONT run when they are missing. IBM Plex Sans (shipped with TeX Live)
% is the fallback. Characters missing from the text font (math italic
% letters, some symbols) are taken from DejaVu Sans.
% ---------------------------------------------------------------------------
\newcommand\atbd@setfont[2]{% #1 = file stem, #2 = extra fontspec options
  \setmainfont{#1}[#2,UprightFont=*-Regular,BoldFont=*-Bold,
    ItalicFont=*-Italic,BoldItalicFont=*-BoldItalic]%
  \setsansfont{#1}[#2,UprightFont=*-Regular,BoldFont=*-Bold,
    ItalicFont=*-Italic,BoldItalicFont=*-BoldItalic]}
\IfFontExistsTF{LiberationSans-Regular.ttf}{%
  \atbd@setfont{LiberationSans}{Extension=.ttf}}{%
\IfFontExistsTF{IBMPlexSans-Regular.otf}{%
  % IBM Plex Sans is a little wider than Arial: scale it to keep the pagination.
  \atbd@setfont{IBMPlexSans}{Extension=.otf,Scale=0.95}}{%
  \setmainfont{DejaVu Sans}[Scale=0.9]\setsansfont{DejaVu Sans}[Scale=0.9]}}
\setmonofont{DejaVu Sans Mono}[Scale=0.85]
% Math: upright letters and Greek capitals (\Delta, \mathrm, \mathbf) from
% Computer Modern like the rest of the formulas. fontspec would take them
% from the text font, which has no glyph in those 8-bit slots (U+0001...).
\AtBeginDocument{%
  \DeclareSymbolFont{operators}{OT1}{cmr}{m}{n}%
  \SetSymbolFont{operators}{bold}{OT1}{cmr}{bx}{n}%
  \DeclareMathAlphabet{\mathrm}{OT1}{cmr}{m}{n}%
  \DeclareMathAlphabet{\mathbf}{OT1}{cmr}{bx}{n}%
  \SetMathAlphabet{\mathrm}{bold}{OT1}{cmr}{bx}{n}}
% Line spacing of the originals (Word "multiple 1.15": 15.8 pt at 11 pt).
\linespread{1.16}
\newfontfamily\atbdfallbackfont{DejaVu Sans}[Scale=0.92]
\IfFontExistsTF{DejaVuMathTeXGyre.ttf}{%
  \newfontfamily\atbdmathletterfont{DejaVuMathTeXGyre.ttf}[Scale=0.92]}{%
  \let\atbdmathletterfont\atbdfallbackfont}

% Route symbol blocks to the fallback font (XeTeX inter-character tokens).
\ifdefined\XeTeXinterchartokenstate
  \newXeTeXintercharclass\atbdfallbackclass
  \newXeTeXintercharclass\atbdmathletterclass
  \def\atbd@fallbackrange#1#2{%
    \count@=#1\relax
    \loop
      \XeTeXcharclass\count@=\atbdfallbackclass
    \ifnum\count@<#2\relax\advance\count@\@ne\repeat}
  \atbd@fallbackrange{"2070}{"209F}% super/subscripts
  \atbd@fallbackrange{"2190}{"22FF}% arrows, mathematical operators
  \atbd@fallbackrange{"2600}{"26FF}% miscellaneous symbols
  \XeTeXcharclass"03D1=\atbdfallbackclass % theta symbol
  \XeTeXcharclass"2011=\atbdfallbackclass % non-breaking hyphen
  \XeTeXcharclass"FFFD=\atbdfallbackclass
  \count@="1D400\relax
  \loop
    \XeTeXcharclass\count@=\atbdmathletterclass
  \ifnum\count@<"1D7FF\relax\advance\count@\@ne\repeat
  \XeTeXinterchartoks 0 \atbdfallbackclass = {\begingroup\atbdfallbackfont}
  \XeTeXinterchartoks 4095 \atbdfallbackclass = {\begingroup\atbdfallbackfont}
  \XeTeXinterchartoks \atbdfallbackclass 0 = {\endgroup}
  \XeTeXinterchartoks \atbdfallbackclass 4095 = {\endgroup}
  \XeTeXinterchartoks 0 \atbdmathletterclass = {\begingroup\atbdmathletterfont}
  \XeTeXinterchartoks 4095 \atbdmathletterclass = {\begingroup\atbdmathletterfont}
  \XeTeXinterchartoks \atbdmathletterclass 0 = {\endgroup}
  \XeTeXinterchartoks \atbdmathletterclass 4095 = {\endgroup}
  \XeTeXinterchartoks \atbdfallbackclass \atbdmathletterclass = {\endgroup\begingroup\atbdmathletterfont}
  \XeTeXinterchartoks \atbdmathletterclass \atbdfallbackclass = {\endgroup\begingroup\atbdfallbackfont}
  \AtBeginDocument{\XeTeXinterchartokenstate=1\relax}
\fi

% ---------------------------------------------------------------------------
% Headings: numbers come from the source titles ("1. Introduction",
% "1.1 Context"), so LaTeX numbering is switched off. Headings hang 1.25 cm
% into the left margin, as in the original where the body text is indented.
% ---------------------------------------------------------------------------
\setcounter{secnumdepth}{-1}
\setcounter{tocdepth}{3}
\newlength\atbdheadindent
\setlength\atbdheadindent{1.25cm}

\titleformat{\chapter}[block]
  {\color{atbdblue}\fontsize{24}{28}\selectfont\bfseries}{}{0pt}{}
\titlespacing*{\chapter}{-\atbdheadindent}{0pt}{18pt}
\titleformat{\section}[block]
  {\color{atbdblue}\fontsize{16}{19}\selectfont}{}{0pt}{}
\titlespacing*{\section}{-\atbdheadindent}{16pt}{10pt}
\titleformat{\subsection}[block]
  {\color{atbdblue}\fontsize{13}{16}\selectfont}{}{0pt}{}
\titlespacing*{\subsection}{-\atbdheadindent}{14pt}{8pt}
\titleformat{\subsubsection}[block]
  {\color{atbdblue}\fontsize{12}{14}\selectfont}{}{0pt}{}
\titlespacing*{\subsubsection}{-\atbdheadindent}{12pt}{6pt}
\titleformat{\paragraph}[block]
  {\color{atbdblue}\normalsize\bfseries}{}{0pt}{}
\titlespacing*{\paragraph}{-\atbdheadindent}{10pt}{4pt}
\titleformat{\subparagraph}[block]
  {\color{atbdblue}\normalsize\itshape}{}{0pt}{}
\titlespacing*{\subparagraph}{-\atbdheadindent}{8pt}{4pt}

% Front-matter headings (Document information, Change history, contents).
\newcommand\atbdfrontheading[1]{%
  \par\vspace*{0pt}%
  {\noindent\hspace*{-\atbdheadindent}\color{atbdblue}%
   \fontsize{16}{19}\selectfont #1\par}%
  \vspace{12pt}}

% ---------------------------------------------------------------------------
% Table of contents: unnumbered entries carrying their source numbers.
% ---------------------------------------------------------------------------
\renewcommand\cftchapfont{\bfseries}
\renewcommand\cftchappagefont{\bfseries}
\renewcommand\cftchapleader{\cftdotfill{\cftdotsep}}
\setlength\cftbeforechapskip{4pt}
\setlength\cftchapindent{-\atbdheadindent}
\setlength\cftsecindent{\dimexpr-\atbdheadindent+1.0em\relax}
\setlength\cftsubsecindent{\dimexpr-\atbdheadindent+2.0em\relax}
\setlength\cftsubsubsecindent{\dimexpr-\atbdheadindent+3.0em\relax}
\renewcommand\cfttoctitlefont{\hspace*{-\atbdheadindent}\color{atbdblue}%
  \fontsize{16}{19}\selectfont}
\renewcommand\cftaftertoctitle{}
\setlength\cftbeforetoctitleskip{0pt}
\setlength\cftaftertoctitleskip{12pt}
\renewcommand\cftpnumalign{r}

\newcommand\atbdtableofcontents{%
  \clearpage
  \begingroup
    \parskip\z@skip
    \renewcommand\contentsname{Table of contents}%
    \hypersetup{linkcolor=black}%
    \tableofcontents
  \endgroup
  \clearpage}

% ---------------------------------------------------------------------------
% Header and footer
% ---------------------------------------------------------------------------
\newcommand\atbdheaderbox{%
  {\fontsize{9.5}{11.5}\selectfont\color{atbdgrey}%
   \arrayrulecolor{atbdbox}\setlength\arrayrulewidth{0.5pt}%
   \renewcommand\arraystretch{1.15}%
   \begin{tabular}[b]{|p{6.15cm}|p{1.2cm}|p{2.45cm}|}
     \hline
     \multicolumn{3}{|p{10.4cm}|}{\atbdtitle}\\
     \hline
     \atbdcode & \atbdissue & \atbddate\\
     \hline
   \end{tabular}}}
% Typeset once: a tabular built inside the output routine can break a
% tabulary being measured on the same page.
\newsavebox\atbd@headerboxsaved
\AtBeginDocument{\sbox\atbd@headerboxsaved{\atbdheaderbox}}

\newcommand\atbdheaderlogo{%
  \IfFileExists{Aresys_light.png}{%
    \includegraphics[height=1.35cm]{Aresys_light.png}}{}}

\newcommand\atbdfootline{%
  \color{atbdgrey}\fontsize{8.5}{10}\selectfont
  \atbdissueline}

\newcommand\atbd@headfoot{%
  \fancyhf{}%
  \fancyhfoffset[L]{\atbdheadindent}%
  \fancyhead[L]{\atbdheaderlogo}%
  \fancyhead[R]{\usebox\atbd@headerboxsaved}%
  \fancyfoot[L]{\atbdfootline}%
  \fancyfoot[C]{\color{atbdnavy}page \thepage/\pageref*{LastPage}}%
  \fancyfoot[R]{\color{atbdgrey}\fontsize{8.5}{10}\selectfont\atbdcode}%
  \renewcommand\headrule{{\color{atbdrule}%
    \hrule height 0.75pt width\headwidth\vskip-0.75pt}}%
  \renewcommand\footrule{{\color{atbdrule}%
    \hrule height 0.75pt width\headwidth\vskip 3pt}}%
  \renewcommand\headrulewidth{0.75pt}%
  \renewcommand\footrulewidth{0.75pt}}
% Sphinx switches between "normal" and "plain" (chapter openings): both get
% the document header and footer.
\fancypagestyle{normal}{\atbd@headfoot}
\fancypagestyle{plain}{\atbd@headfoot}

% ---------------------------------------------------------------------------
% Cover page
% ---------------------------------------------------------------------------
\newcommand\atbdmaketitle{%
  \begingroup
  \thispagestyle{empty}%
  \hypersetup{pdftitle={\atbdtitle},pdfsubject={\atbdcode}}%
  \noindent\hspace*{-\atbdheadindent}%
  \begin{minipage}[t]{\dimexpr\textwidth+\atbdheadindent\relax}
    \vspace*{-1.2cm}%
    \IfFileExists{Aresys_light.png}{%
      \includegraphics[height=1.9cm]{Aresys_light.png}}{}%
    \hfill
    \IfFileExists{ESA_light.png}{%
      \includegraphics[height=1.9cm]{ESA_light.png}}{}%
    \par\vspace*{3.2cm}%
    \raggedright
    {\color{atbdtitlegrey}\fontsize{40}{48}\selectfont\atbdcovertitle\par}%
    \vspace*{0.35cm}%
    {\color{atbdgrey}\rule{\linewidth}{0.8pt}\par}%
  \end{minipage}%
  \vfill
  \noindent\hspace*{-\atbdheadindent}%
  {\setlength\fboxsep{0pt}%
   \colorbox{atbdbox}{\makebox[\dimexpr\textwidth+\atbdheadindent\relax]{%
     \rule{0pt}{0.38cm}}}}\par\nointerlineskip
  \noindent\hspace*{-\atbdheadindent}%
  {\setlength\fboxsep{0pt}%
   \colorbox{atbdcover}{%
     \begin{minipage}[b][4.6cm][b]{\dimexpr\textwidth+\atbdheadindent\relax}
       \raggedleft\fontsize{11}{15}\selectfont
       \begin{tabular}{@{}l@{}}
         \textbf{Ref}: \atbdcode\\
         \textbf{Issue}: \atbdissue\\
         \textbf{Date}: \atbddate\\[3pt]
         \atbdissueline
       \end{tabular}\hspace*{0.5cm}\par\vspace*{0.45cm}%
     \end{minipage}}}\par
  \clearpage
  \endgroup}

% ---------------------------------------------------------------------------
% Body spacing: Word paragraphs of the originals (6 pt after), compact lists
% and displayed equations.
% ---------------------------------------------------------------------------
\setlength\parskip{4pt plus 1pt}
\def\@listi{\leftmargin\leftmargini\topsep 3pt plus 1pt\parsep\z@\itemsep 1pt}
\let\@listI\@listi
\def\@listii{\leftmargin\leftmarginii\topsep 1pt\parsep\z@\itemsep\z@}
\def\@listiii{\leftmargin\leftmarginiii\topsep 1pt\parsep\z@\itemsep\z@}
\AtBeginDocument{%
  \setlength\abovedisplayskip{8pt plus 2pt}%
  \setlength\belowdisplayskip{8pt plus 2pt}%
  \setlength\abovedisplayshortskip{2pt plus 1pt}%
  \setlength\belowdisplayshortskip{4pt plus 1pt}}

% ---------------------------------------------------------------------------
% Tables (see _templates/latex/longtable.tex.jinja): ragged-right cells, the
% table font of the originals, as wide as the headings (left indent).
% ---------------------------------------------------------------------------
\newcolumntype{\X}[2]{>{\raggedright\arraybackslash}p{\dimexpr
      (\linewidth-\spx@arrayrulewidth)*#1/#2-\tw@\tabcolsep-\spx@arrayrulewidth\relax}}
\newcommand\atbdwidetable{%
  \advance\linewidth\atbdheadindent
  \advance\@totalleftmargin-\atbdheadindent}
% Bold header row, as in the originals.
\renewcommand\sphinxstyletheadfamily{\sffamily\bfseries}
\newlength\atbdcaptionskip
\setlength\atbdcaptionskip{4pt}
% Inline formulas wider than their column are scaled down to it, to 70 % at
% most (smaller would not be legible).
\newcommand\atbdfitmath[1]{%
  \allowbreak\sbox\z@{#1}%
  \ifdim\wd\z@>\linewidth
    \dimen@=0.7\wd\z@
    \ifdim\dimen@<\linewidth\dimen@=\linewidth\fi
    \resizebox{\dimen@}{!}{\usebox\z@}%
  \else\usebox\z@\fi}
% Numbered equations (atbd_latex_content.py): multi-line body aligned on &
% like split, scaled down when wider than the text minus the tag.
\newcommand\atbdfitdisplay[1]{%
  \sbox\z@{$\displaystyle\begin{aligned}#1\end{aligned}$}%
  \ifdim\wd\z@>\dimexpr\linewidth-4em\relax
    \resizebox{\dimexpr\linewidth-4em\relax}{!}{\usebox\z@}%
  \else\usebox\z@\fi}
% Underscores of long identifiers may break the line inside table cells.
\AtBeginEnvironment{longtable}{%
  \let\atbd@underscore\_%
  \def\_{\atbd@underscore\allowbreak}}

% A caption below the table (\endlastfoot) is taller than the foot reserved
% at each page break, and its depth (\parbox[t]) is not counted: when the
% last rows fit but not the caption, longtable sets the caption alone at the
% top of the next page. Carry
% the last rows over with it instead (longtable.sty \LT@output, end branch).
\newbox\atbd@ltrows
\def\LT@output{%
  \ifnum\outputpenalty <-\@Mi
    \ifnum\outputpenalty > -\LT@end@pen
      \LT@err{floats and marginpars not allowed in a longtable}\@ehc
    \else
      \setbox\z@\vbox{\unvbox\@cclv}%
      \dimen@\dp\LT@lastfoot \advance\dimen@\ht\LT@lastfoot
      \ifdim \dimen@>\ht\LT@foot
        \dimen@\pagegoal
        \advance\dimen@\ht\LT@foot
        \advance\dimen@-\ht\LT@lastfoot
        \advance\dimen@-\dp\LT@lastfoot
        \ifdim\dimen@<\ht\z@
          \begingroup
            \vbadness\@M \vfuzz\maxdimen \splittopskip\z@ \splitmaxdepth\maxdimen
            \global\setbox\atbd@ltrows\vsplit\z@ to \dimen@
          \endgroup
          \setbox\@cclv\vbox{\unvbox\atbd@ltrows\copy\LT@foot\vss}%
          \@makecol
          \@outputpage
          \global\vsize\@colroom
          \setbox\z@\vbox{\box\LT@head\nobreak\unvbox\z@}%
        \fi
      \fi
        \unvbox\z@\nobreak\box\ifvoid\LT@lastfoot\LT@foot\else\LT@lastfoot\fi
    \fi
  \else
    \setbox\@cclv\vbox{\unvbox\@cclv\copy\LT@foot\vss}%
    \@makecol
    \@outputpage
      \global\vsize\@colroom
    \copy\LT@head\nobreak
  \fi}

% ---------------------------------------------------------------------------
% Notes: italic "NOTE: ..." paragraphs as in the originals (no frame). The
% other admonitions keep the Sphinx boxes.
% ---------------------------------------------------------------------------
\def\atbd@notename{note}
\newif\ifatbd@plainnote
\let\atbd@admonition\sphinxadmonition
\let\atbd@endadmonition\endsphinxadmonition
\renewenvironment{sphinxadmonition}[2]{%
  \def\atbd@tmp{#1}%
  \ifx\atbd@tmp\atbd@notename
    \atbd@plainnotetrue\par\addvspace{4pt}\itshape
    \everypar{\everypar{}NOTE:\ }%
  \else\atbd@plainnotefalse\atbd@admonition{#1}{#2}\fi}
  {\ifatbd@plainnote\par\addvspace{4pt}\else\atbd@endadmonition\fi}

% ---------------------------------------------------------------------------
% Captions: bold "Fig.N" / "Tab.N" label then the text, as in the originals.
% ---------------------------------------------------------------------------
\renewcommand\fnum@figure{\textbf{Fig.\thefigure}}
\renewcommand\fnum@table{\textbf{Tab.\thetable}}
\long\def\@makecaption#1#2{%
  \vskip\abovecaptionskip
  \sbox\@tempboxa{#1\enspace #2}%
  \ifdim\wd\@tempboxa>\hsize #1\enspace #2\par
  \else\global\@minipagefalse\hb@xt@\hsize{\hfil\box\@tempboxa\hfil}\fi
  \vskip\belowcaptionskip}
\def\LT@makecaption#1#2#3{%
  \LT@mcol\LT@cols c{\sphinxnorowcolor\hbox to\z@{\hss\parbox[t]\LTcapwidth{%
    \sbox\@tempboxa{#1{#2\enspace}#3}%
    \ifdim\wd\@tempboxa>\hsize #1{#2\enspace}#3%
    \else\hbox to\hsize{\hfil\box\@tempboxa\hfil}\fi
    \endgraf\vskip\baselineskip}\hss}}}

% ---------------------------------------------------------------------------
% Figures: floating ([!htp]), at the size of the original rendering
% (raster images are shown at 65 % of their 72 dpi size), never wider than
% 85 % of the text width; white margins of the rasters are trimmed with the
% values computed at build time (atbdtrim.tex, see atbd_latex_content.py).
% ---------------------------------------------------------------------------
\setcounter{topnumber}{3}
\setcounter{bottomnumber}{0}
\setcounter{totalnumber}{4}
\renewcommand\topfraction{.9}
\renewcommand\bottomfraction{.8}
\renewcommand\textfraction{.1}
\renewcommand\floatpagefraction{.8}
% \atbdfigurehere: the next figure is set in place ([H]); used before a
% longtable, which ignores pending floats when it breaks the page.
\newif\ifatbd@figurehere
\newcommand\atbdfigurehere{\atbd@figureheretrue}
\let\atbd@figure\figure
\renewcommand\figure[1][\fps@figure]{%
  \ifatbd@figurehere\atbd@figureherefalse\atbd@figure[H]%
  \else\atbd@figure[#1]\fi}
\newcommand\atbdfigscale{0.65}
\newcommand\atbdfigmaxwidth{0.85\linewidth}
\newcommand\atbdsettrim[2]{\@namedef{atbd@trim@\detokenize{#1}}{#2}}
\InputIfFileExists{atbdtrim.tex}{}{}
\let\atbd@sphinxincludegraphics\sphinxincludegraphics
\renewcommand\sphinxincludegraphics[2][]{%
  \begingroup
  \@ifundefined{atbd@trim@\detokenize{#2}}%
    {\def\atbd@trim{}}%
    {\edef\atbd@trim{trim=\csname atbd@trim@\detokenize{#2}\endcsname,clip,}}%
  \ifx\relax#1\relax
    \setbox\z@\hbox{\expandafter\includegraphics\expandafter[\atbd@trim draft]{#2}}%
    \dimen@=\atbdfigscale\wd\z@
    \edef\atbd@opts{\atbd@trim width=\the\dimen@}%
  \else
    \edef\atbd@opts{\atbd@trim #1}%
  \fi
  \linewidth=\atbdfigmaxwidth
  \expandafter\atbd@sphinxincludegraphics\expandafter[\atbd@opts]{#2}%
  \endgroup}

\endinput
