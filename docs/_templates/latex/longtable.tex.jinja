<%- set wide = 'atbd-wide' in table.classes -%>
<%- set below = 'atbd-caption-below' in table.classes and table.caption -%>
<#- Sphinx longtable template (sphinx/templates/latex/longtable.tex.jinja)
    adapted to the Science Guide PDF exports (see atbdlayout.sty):
    * table font of the original documents;
    * "atbd-wide": the table also uses the left indent of the headings;
    * "atbd-caption-below": caption under the table (PFD originals);
    * "atbd-front": front-matter table, compact rows;
    * grid of the originals (atbdtablegrid), centred cells in the input and
      output tables of the ATBDs ("atbd-centered");
    * the closing rule is part of the last foot, so that it cannot be left
      alone on a page after the repeated header (orphan header);
    * header repeated on each page, without "continued" notes. -#>
\begin{savenotes}
\sphinxatlongtablestart
\sphinxthistablewithglobalstyle
<% if 'booktabs' in table.styles -%>
\sphinxthistablewithbooktabsstyle
<% endif -%>
<% if 'borderless' in table.styles -%>
\sphinxthistablewithborderlessstyle
<% endif -%>
<% if 'standard' in table.styles -%>
\sphinxthistablewithstandardstyle
<% endif -%>
<% if 'vlines' in table.styles -%>
\sphinxthistablewithvlinesstyle
<% endif -%>
<% if 'novlines' in table.styles -%>
\sphinxthistablewithnovlinesstyle
<% endif -%>
<% if 'colorrows' in table.styles -%>
\sphinxthistablewithcolorrowsstyle
<% endif -%>
<% if 'nocolorrows' in table.styles -%>
\sphinxthistablewithnocolorrowsstyle
<% endif -%>
\atbdrowcontinuation
\atbdtablefont
\atbdtablegrid
<% if 'atbd-centered' in table.classes -%>
\atbdcenteredcells
<% endif -%>
<% if 'atbd-front' in table.classes -%>
\renewcommand\arraystretch{1.3}
<% endif -%>
<% if wide -%>
\atbdwidetable
<% endif -%>
\makeatletter
<%- if table.align in ('center', 'default') %>
  \LTleft \@totalleftmargin plus1fill
  \LTright\dimexpr\columnwidth-\@totalleftmargin-\linewidth\relax plus1fill
<%- elif table.align == 'left' %>
  \LTleft \@totalleftmargin
  \LTright\dimexpr\columnwidth-\@totalleftmargin-\linewidth\relax plus1fill
<%- elif table.align == 'right' %>
  \LTleft \@totalleftmargin plus1fill
  \LTright\dimexpr\columnwidth-\@totalleftmargin-\linewidth\relax
<%- endif %>
\makeatother
\LTcapwidth\linewidth
\begin{longtable}<%= table.get_colspec() %>
<%- if table.caption and not below -%>
\sphinxthelongtablecaptionisattop
<%- if 'atbd-lead' in table.classes %>
\noalign{\atbdleadcaption}\caption*{<%= ''.join(table.caption) %>\strut}<%= labels %>\\*
<%- else %>
\caption{<%= ''.join(table.caption) %>\strut}<%= labels %>\\*[\sphinxlongtablecapskipadjust]
<%- endif %>
<% elif labels and not below -%>
\noalign{\phantomsection<%= labels %>}%
<% endif -%>
\sphinxtoprule
<%= ''.join(table.header) -%>
<%- if table.header -%>
\sphinxmidrule
<% endif -%>
\endfirsthead

\sphinxtoprule
<%= ''.join(table.header) -%>
<%- if table.header -%>
\sphinxmidrule
<% endif -%>
\endhead

\sphinxbottomrule
\endfoot

<% if below -%>
\noalign{\vskip\atbdcaptionskip}%
\caption{<%= ''.join(table.caption) %>\strut}\\
<% endif -%>
<% if not below -%>
\sphinxbottomrule
<% endif -%>
\endlastfoot
\nopagebreak
\sphinxtableatstartofbodyhook
<%= ''.join(table.body) -%>
<% if below -%>
\sphinxbottomrule
<% endif -%>
\end{longtable}
<% if below and labels -%>
\phantomsection<%= labels %>
<% endif -%>
\sphinxtableafterendhook
\sphinxatlongtableend
\end{savenotes}
