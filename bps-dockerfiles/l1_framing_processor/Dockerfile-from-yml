FROM bps-prereq:latest

COPY pkgs /tmp/python-packages
COPY environment.yml /tmp/environment.yml

LD_LIBRARY_PATH=/opt/conda_folder/envs/env/lib/bps-l1-framing-processor-libs

USER root
RUN bash -c "conda index --verbose /tmp/python-packages && \
    conda env update --file /tmp/environment.yml && \
    conda clean -afy" && \
    rm -fr /tmp/python-packages && \
    rm -f /tmp/environment.yml && \
    ln -s /opt/conda_folder/envs/env/bin/bps_l1_framing_processor /usr/local/bin/

USER nobody
CMD /bin/bash
